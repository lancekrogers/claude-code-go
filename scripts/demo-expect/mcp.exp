#!/usr/bin/expect -f
# MCP demo - shows Model Context Protocol integration

set timeout 120
log_user 1

# Show the command being run, then execute it
spawn -noecho bash -c "echo '\$ just demo mcp' && sleep 0.5 && cd $env(PROJECT_DIR) && just demo mcp"

# Wait for initial display and prompt
expect ">>>"

# Create example MCP configuration
send "/example\r"
expect ">>>"

# Show status with MCP configured
send "/status\r"
expect ">>>"

# Show available MCP tools
send "/tools\r"
expect ">>>"

# Toggle strict mode
send "/strict on\r"
expect ">>>"

# Show status with strict mode
send "/status\r"
expect ">>>"

# Exit
send "exit\r"
expect eof
