#!/usr/bin/expect -f
# Retry demo - shows retry and error handling features

set timeout 120
log_user 1

# Show the command being run, then execute it
spawn -noecho bash -c "echo '\$ just demo retry' && sleep 0.5 && cd $env(PROJECT_DIR) && just demo retry"

# Wait for initial display and prompt
expect ">>>"

# Show current status (enhanced mode should be on by default)
send "/status\r"
expect ">>>"

# Switch to aggressive retry policy for more retries
send "/aggressive\r"
expect ">>>"

# Show updated status
send "/status\r"
expect ">>>"

# Test retry behavior with timeout to trigger real retries
send "/test-retry\r"
expect ">>>"

# Show cumulative statistics after test
send "/stats\r"
expect ">>>"

# Exit
send "exit\r"
expect eof
