#!/usr/bin/expect -f
# Retry demo - shows retry and error handling features

set timeout 120
log_user 1

# Use environment variable for binary path
spawn $env(DEMO_BINARY)

# Wait for initial display and prompt
expect ">>>"

# Show current status
send "/status\r"
expect ">>>"

# Switch to aggressive retry policy
send "/aggressive\r"
expect ">>>"

# Show updated status
send "/status\r"
expect ">>>"

# Send a simple query to demonstrate retry handling
send "What is 5 times 7?\r"
expect ">>>"

# Exit
send "exit\r"
expect eof
